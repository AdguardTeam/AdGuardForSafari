::-webkit-scrollbar {
  -webkit-appearance: none;
  width: 6px;
  height: 6px;
  cursor: pointer;
  margin: 6px;
}

::-webkit-scrollbar-track {
  background-color: rgba(57,57,57, .6);
  border-radius: 8px;
  cursor: pointer;
}

::-webkit-scrollbar-thumb {
  border-radius: 8px;
  background-color: rgba(156, 156, 156, .6);
}
